<?xml version="1.0" encoding="UTF-8"?>
<!--
  stackflow-api-contract: REST contract of StackFlowServer, DTO records named *DTO with Bean Validation.
  Only dependency: jakarta.validation (allowed by rule R1). No logic, no internal modules.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.merlab</groupId>
        <artifactId>stackflow-parent</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>stackflow-api-contract</artifactId>
    <packaging>jar</packaging>
    <name>StackFlowServer :: API Contract</name>

    <dependencies>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
    </dependencies>
</project>
