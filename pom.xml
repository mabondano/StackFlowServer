<?xml version="1.0" encoding="UTF-8"?>
<!--
  StackFlowServer v2 - parent POM.

  Modules are added in the roadmap step that first needs them (docs/v2/ROADMAP.md, step 0.2.6):
  domain, ports, api-contract, adapter-jakarta and host-wildfly come first (milestone 0.2);
  rpn, registry, runtime, jobs, pipeline, storage, security, application and the engine adapters later.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.merlab</groupId>
    <artifactId>stackflow-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>StackFlowServer</name>
    <description>Runtime of the MerLab platform: MerLabCore RPN stack, signal processing and ML as a Jakarta EE REST server.</description>

    <modules>
        <module>stackflow-domain</module>
        <module>stackflow-ports</module>
        <module>stackflow-api-contract</module>
        <module>stackflow-adapter-jakarta</module>
        <module>stackflow-host-wildfly</module>
    </modules>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Platform -->
        <jakartaee.version>10.0.0</jakartaee.version>
        <jakarta.validation.version>3.0.2</jakarta.validation.version>

        <!-- Test libraries -->
        <junit.version>5.11.4</junit.version>
        <mockito.version>5.14.2</mockito.version>
        <archunit.version>1.3.0</archunit.version>

        <!-- Maven plugins -->
        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.5.3</maven.surefire.plugin.version>
        <maven.failsafe.plugin.version>3.5.3</maven.failsafe.plugin.version>
        <maven.war.plugin.version>3.4.0</maven.war.plugin.version>
        <maven.enforcer.plugin.version>3.5.0</maven.enforcer.plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>jakarta.platform</groupId>
                <artifactId>jakarta.jakartaee-api</artifactId>
                <version>${jakartaee.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <!-- Bean Validation 3.0 = the version in Jakarta EE 10 (WildFly provides it) -->
                <groupId>jakarta.validation</groupId>
                <artifactId>jakarta.validation-api</artifactId>
                <version>${jakarta.validation.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-junit-jupiter</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
      Optional engines (DISENO_REVISION_2 §8). Each profile adds its adapter module when that module exists:
        pegasus    -> stackflow-adapter-pegasus     (group J)
        modelforge -> stackflow-adapter-modelforge  (group H)
      Without a profile, StackFlow builds and runs with MerLabCore only; the Unavailable* beans answer
      503 ENGINE_NOT_INSTALLED.
    -->
    <profiles>
        <profile>
            <id>pegasus</id>
            <!--
              Active automatically when the PegasusRAG jar (MerLabRAG) is installed in the local repository.
              Maven only interpolates system properties here, so the version is written literally;
              update it when merlab-rag changes version. Force: -Ppegasus. Disable: -P!pegasus.
            -->
            <activation>
                <file>
                    <exists>${user.home}/.m2/repository/com/merlab/rag/merlab-rag/0.1.0-SNAPSHOT/merlab-rag-0.1.0-SNAPSHOT.jar</exists>
                </file>
            </activation>
            <modules>
                <!-- <module>stackflow-adapter-pegasus</module>  (added in step J2.2) -->
            </modules>
        </profile>
        <profile>
            <id>modelforge</id>
            <!--
              Never active by default: ModelForge runs remotely on a Mac mini and is reached over HTTP.
              Enable with -Pmodelforge.
            -->
            <modules>
                <!-- <module>stackflow-adapter-modelforge</module>  (added in step H3.3) -->
            </modules>
        </profile>
    </profiles>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.plugin.version}</version>
                    <configuration>
                        <includes>
                            <include>**/*Test.java</include>
                        </includes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven.failsafe.plugin.version}</version>
                    <configuration>
                        <includes>
                            <include>**/*IT.java</include>
                        </includes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-war-plugin</artifactId>
                    <version>${maven.war.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven.enforcer.plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[17,)</version>
                                    <message>StackFlowServer v2 needs Java 17 or newer.</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                    <message>StackFlowServer v2 needs Maven 3.9 or newer.</message>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
